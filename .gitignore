# ========================================================
# Git Ignore Rules
# Prevents sensitive credentials, temporary caches, and system
# files from being pushed to GitHub.
# ========================================================

# 1. Environment & Secret Keys (CRITICAL)
.env
.env.*
*.env
backend/.env
frontend/.env
# Exception: allow template examples to be tracked
!.env.example
!*.env.example

# 2. Node & JavaScript
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 3. Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# 3. Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# 4. Logs & Databases
*.log
*.sqlite
*.sqlite3
*.db

# 5. IDE & Editor Artifacts
.vscode/
.idea/
*.swp
*.swo
*~
.project
.pydevproject
.settings/

# 6. Operating System Artifacts
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# 7. Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
